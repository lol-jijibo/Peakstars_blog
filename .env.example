# ============================================================
# PeakStars Blog - 环境变量模板
# 复制此文件为 .env 并按实际情况填写
# 生产环境部署时的必填环境变量
# ============================================================

# ---- 数据库 ----
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# ---- JWT 认证 (生产环境请用 openssl rand -hex 32 生成) ----
AUTH_TOKEN_SECRET=your_jwt_secret_here

# ---- 邮箱 SMTP ----
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_qq_smtp_auth_code

# ---- 阿里云 OSS (生产环境请填写真实值) ----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_BUCKET=stars-book

# ---- Redis (生产环境必须设置密码) ----
REDIS_PASSWORD=
